#
# MDEV-38814: btr_cur_need_opposite_intention() should not
# trigger index lock upgrade on the root page
#
# Test with simple table structure:
# Single INT primary key
# DATETIME column dt that starts NULL and gets updated to NOW()
#
# The NULL-to-DATETIME growth (0 → 5 bytes) makes
# btr_cur_optimistic_update() return DB_OVERFLOW on a full page,
# falling through to the pessimistic path (BTR_MODIFY_TREE).
#
# 5000 rows (~15 bytes each) produce enough page splits to exercise
# the btr_insert_into_right_sibling() guard and index lock upgrade logic.
CREATE TABLE t1 (
id INT NOT NULL,
dt DATETIME NULL,
PRIMARY KEY (id)
) ENGINE=InnoDB;
# Rows inserted with NULL DATETIME
SELECT COUNT(*) AS rows_inserted FROM t1;
rows_inserted
5000
# Counters after INSERT phase (delta)
SELECT @i_upgrades AS index_lock_upgrades,
@i_root AS opposite_intention_root,
@i_rs_x AS right_sibling_x,
@i_rs_sx AS right_sibling_sx_skip;
index_lock_upgrades	opposite_intention_root	right_sibling_x	right_sibling_sx_skip
7	7	7	1
# Now update all rows: NULL → NOW() triggers pessimistic path
# due to record size growth on full pages.
# Rows updated
SELECT COUNT(*) AS null_dt FROM t1 WHERE dt IS NULL;
null_dt
0
# Counters after UPDATE phase (delta)
SELECT @u_upgrades AS index_lock_upgrades,
@u_root AS opposite_intention_root,
@u_rs_x AS right_sibling_x,
@u_rs_sx AS right_sibling_sx_skip;
index_lock_upgrades	opposite_intention_root	right_sibling_x	right_sibling_sx_skip
694	1716	7	0
# Total counters (delta from start)
SELECT @i_upgrades + @u_upgrades AS index_lock_upgrades,
@i_root + @u_root AS opposite_intention_root,
@i_rs_x + @u_rs_x AS right_sibling_x,
@i_rs_sx + @u_rs_sx AS right_sibling_sx_skip;
index_lock_upgrades	opposite_intention_root	right_sibling_x	right_sibling_sx_skip
701	1723	14	1
DROP TABLE t1;
