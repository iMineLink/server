#
# MDEV-38814: High rate of index_lock_upgrades due to
# btr_cur_need_opposite_intention() mostly returning true
#
# Test with table t1 (primary key only)
CREATE TABLE t1 (
id INT NOT NULL,
dt DATETIME NULL,
PRIMARY KEY (id)
) ENGINE=InnoDB;
# Insert 10k rows with NULL DATETIME
InnoDB		0 transactions not purged
INSERT INTO t1 (id, dt) SELECT seq, NULL FROM seq_1_to_10000;
# Rows inserted with NULL DATETIME
SELECT COUNT(*) AS rows_inserted FROM t1;
