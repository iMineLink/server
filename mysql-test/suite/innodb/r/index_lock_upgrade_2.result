#
# MDEV-38814: High rate of index_lock_upgrades due to
# btr_cur_need_opposite_intention() mostly returning true
#
# Test with simple table structure:
# Single INT primary key
# DATETIME column dt that starts not-NULL and gets updated to NULL
#
CREATE TABLE t1 (
id INT NOT NULL,
dt DATETIME NULL,
PRIMARY KEY (id)
) ENGINE=InnoDB;
InnoDB		0 transactions not purged
INSERT INTO t1 (id, dt) SELECT seq, '2025-01-01' + INTERVAL seq SECOND FROM seq_1_to_1000;
# Rows inserted with not-NULL DATETIME
SELECT COUNT(*) AS rows_inserted FROM t1;
rows_inserted
1000
SELECT COUNT(DISTINCT dt) AS distinct_timestamps FROM t1;
distinct_timestamps
1000
InnoDB		0 transactions not purged
# Index lock upgrades during inserts
SELECT @lu01 AS index_lock_upgrades_insert;
index_lock_upgrades_insert
7
SELECT @pi01 AS pessimistic_insert_calls_insert;
pessimistic_insert_calls_insert
8
SELECT @pu01 AS pessimistic_update_calls_insert;
pessimistic_update_calls_insert
0
SELECT @pe01 AS pessimistic_delete_calls_insert;
pessimistic_delete_calls_insert
0
SELECT @ou01 AS optim_err_underflows_insert;
optim_err_underflows_insert
0
SELECT @oo01 AS optim_err_overflows_insert;
optim_err_overflows_insert
0
SELECT @ps01 AS index_page_splits_insert;
index_page_splits_insert
8
SELECT @ma01 AS index_page_merge_attempts_insert;
index_page_merge_attempts_insert
0
SELECT @ms01 AS index_page_merge_successful_insert;
index_page_merge_successful_insert
0
SELECT @rs01 AS index_page_reorg_successful_insert;
index_page_reorg_successful_insert
0
SELECT @pd01 AS index_page_discards_insert;
index_page_discards_insert
0
# Now update all rows (batch update)
UPDATE t1 SET dt= NULL;
# Rows updated
SELECT COUNT(DISTINCT dt) AS distinct_timestamps FROM t1;
distinct_timestamps
0
InnoDB		0 transactions not purged
# Index lock upgrades during updates
SELECT @lu12 AS index_lock_upgrades_update;
index_lock_upgrades_update
66
SELECT @pi12 AS pessimistic_insert_calls_update;
pessimistic_insert_calls_update
0
SELECT @pu12 AS pessimistic_update_calls_update;
pessimistic_update_calls_update
66
SELECT @pe12 AS pessimistic_delete_calls_update;
pessimistic_delete_calls_update
1
SELECT @ou12 AS optim_err_underflows_update;
optim_err_underflows_update
66
SELECT @oo12 AS optim_err_overflows_update;
optim_err_overflows_update
0
SELECT @ps12 AS index_page_splits_update;
index_page_splits_update
0
SELECT @ma12 AS index_page_merge_attempts_update;
index_page_merge_attempts_update
66
SELECT @ms12 AS index_page_merge_successful_update;
index_page_merge_successful_update
1
SELECT @rs12 AS index_page_reorg_successful_update;
index_page_reorg_successful_update
1
SELECT @pd12 AS index_page_discards_update;
index_page_discards_update
0
# Now delete rows so that some pages will be emptied too
DELETE FROM t1 WHERE id > 500 OR id % 2 = 0;
# Rows remaining
SELECT COUNT(*) AS rows_remaining FROM t1;
rows_remaining
250
InnoDB		0 transactions not purged
# Index lock upgrades during deletes
SELECT @lu23 AS index_lock_upgrades_delete;
index_lock_upgrades_delete
112
SELECT @pi23 AS pessimistic_insert_calls_delete;
pessimistic_insert_calls_delete
0
SELECT @pu23 AS pessimistic_update_calls_delete;
pessimistic_update_calls_delete
0
SELECT @pe23 AS pessimistic_delete_calls_delete;
pessimistic_delete_calls_delete
118
SELECT @ou23 AS optim_err_underflows_delete;
optim_err_underflows_delete
0
SELECT @oo23 AS optim_err_overflows_delete;
optim_err_overflows_delete
0
SELECT @ps23 AS index_page_splits_delete;
index_page_splits_delete
0
SELECT @ma23 AS index_page_merge_attempts_delete;
index_page_merge_attempts_delete
112
SELECT @ms23 AS index_page_merge_successful_delete;
index_page_merge_successful_delete
6
SELECT @rs23 AS index_page_reorg_successful_delete;
index_page_reorg_successful_delete
6
SELECT @pd23 AS index_page_discards_delete;
index_page_discards_delete
0
DROP TABLE t1;
