#
# MDEV-38814: High rate of index_lock_upgrades due to
# btr_cur_need_opposite_intention() mostly returning true
#
# Test with simple table structure:
# Single INT primary key
# DATETIME column dt that is updated from a not-NULL value to another one
#
CREATE TABLE t1 (
id INT NOT NULL,
dt DATETIME NULL,
PRIMARY KEY (id)
) ENGINE=InnoDB;
InnoDB		0 transactions not purged
INSERT INTO t1 (id, dt) SELECT seq, '2025-01-01' + INTERVAL seq SECOND FROM seq_1_to_1000;
# Rows inserted with not-NULL DATETIME
SELECT COUNT(*) AS rows_inserted FROM t1;
rows_inserted
1000
SELECT COUNT(DISTINCT dt) AS distinct_timestamps FROM t1;
distinct_timestamps
1000
InnoDB		0 transactions not purged
index_lock_upgrades_insert
7
pessimistic_insert_calls_insert
8
pessimistic_update_calls_insert
0
pessimistic_delete_calls_insert
0
optim_err_underflows_insert
0
optim_err_overflows_insert
0
index_x_lock_calls_insert
0
index_page_splits_insert
8
index_page_merge_attempts_insert
0
index_page_merge_successful_insert
0
index_page_reorg_successful_insert
0
index_page_discards_insert
0
# Now update all rows (batch update)
UPDATE t1 SET dt= '2026-01-01' + INTERVAL id SECOND;
# Rows updated
SELECT COUNT(DISTINCT dt) AS distinct_timestamps FROM t1;
distinct_timestamps
1000
InnoDB		0 transactions not purged
index_lock_upgrades_update
0
pessimistic_insert_calls_update
0
pessimistic_update_calls_update
0
pessimistic_delete_calls_update
0
optim_err_underflows_update
0
optim_err_overflows_update
0
index_x_lock_calls_update
0
index_page_splits_update
0
index_page_merge_attempts_update
0
index_page_merge_successful_update
0
index_page_reorg_successful_update
0
index_page_discards_update
0
# Now delete rows so that some pages will be emptied too
DELETE FROM t1 WHERE id > (SELECT MAX(id) FROM t1) / 2 OR id % 2 = 0;
# Rows remaining
SELECT COUNT(*) AS rows_remaining FROM t1;
rows_remaining
250
InnoDB		0 transactions not purged
index_lock_upgrades_delete
4
pessimistic_insert_calls_delete
0
pessimistic_update_calls_delete
0
pessimistic_delete_calls_delete
10
optim_err_underflows_delete
0
optim_err_overflows_delete
0
index_x_lock_calls_delete
3
index_page_splits_delete
0
index_page_merge_attempts_delete
3
index_page_merge_successful_delete
2
index_page_reorg_successful_delete
2
index_page_discards_delete
4
DROP TABLE t1;
