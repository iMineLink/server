--source include/have_innodb.inc
--source include/have_sequence.inc

--echo #
--echo # MDEV-37070: Index AHI options on a table without PRIMARY KEY.
--echo # Exercises the def_search_info->set_enabled_fixed_mask() path in
--echo # innodb_ahi_enable() (ha_innodb.cc), reached only when no
--echo # user-defined index matches the cluster index (GEN_CLUST_INDEX).
--echo #

SET @start_global_value= @@global.innodb_adaptive_hash_index;
SET GLOBAL innodb_adaptive_hash_index= ON;

CREATE TABLE t_nopk (
  col1 INT, col2 INT,
  INDEX idx_1 (col1) adaptive_hash_index=DEFAULT,
  INDEX idx_2 (col1, col2) adaptive_hash_index=YES,
  INDEX idx_3 (col2) adaptive_hash_index=NO
) ENGINE=InnoDB STATS_PERSISTENT=0 adaptive_hash_index=DEFAULT;

SHOW CREATE TABLE t_nopk;

INSERT INTO t_nopk SELECT seq, seq FROM seq_0_to_255;

# Trigger innodb_ahi_enable() repeatedly via ALTER TABLE so the no-PK
# def_search_info path is exercised on each invocation.
ALTER TABLE t_nopk adaptive_hash_index=OFF, ALGORITHM=INSTANT, LOCK=NONE;
ALTER TABLE t_nopk adaptive_hash_index='ON', ALGORITHM=INSTANT, LOCK=NONE;

SELECT COUNT(*) FROM t_nopk FORCE INDEX(idx_1) WHERE col1 >= 0 AND col1 < 256;
SELECT COUNT(*) FROM t_nopk FORCE INDEX(idx_2) WHERE col1 = 50 AND col2 >= 0;
SELECT COUNT(*) FROM t_nopk FORCE INDEX(idx_3) WHERE col2 = 50;

DROP TABLE t_nopk;
SET @@global.innodb_adaptive_hash_index= @start_global_value;
