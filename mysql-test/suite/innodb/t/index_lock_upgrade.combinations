# MDEV-38814 / MDEV-39325: exercise the cross-product of the three independent
# gates that reduce index tree lock SX-to-X upgrades and the merge/split churn
# behind them: innodb_index_shrink, innodb_index_lock_upgrade_root and
# innodb_defer_purge_merges. Each combination sets all three explicitly; the
# first ([on]) is the all-legacy baseline recorded as the base .result, the
# rest are recorded as rdiffs against it.
#
# innodb_index_shrink=OFF: growing-record UPDATEs are not re-merged after the
# delete-then-insert (no DB_UNDERFLOW fallback) and DB_OVERFLOW fallbacks are
# forced to split rather than reorganize; the grow-update upgrade count drops
# sharply. Same-size and shrinking UPDATEs are essentially unaffected.
#
# innodb_index_lock_upgrade_root=OFF: btr_cur_need_opposite_intention() returns
# false for the root page (no parent or siblings, so a structural change cannot
# cascade upward), removing the SX-to-X upgrades the root would otherwise force.
# This is the main lever for shrinking-record UPDATEs; it costs a few extra page
# descents because the optimistic descent no longer bails at the root.
#
# innodb_defer_purge_merges=ON: purge does not attempt a page merge per deleted
# record; under-full pages are recorded and compressed once at the end of the
# batch. This removes the excessive failed purge merge attempts (and the
# pessimistic delete fallbacks / upgrades they drive) on the delete phases and
# on secondary-key in-place UPDATEs (which churn the secondary index via
# delete+insert and are purged afterwards). It is orthogonal to the two
# update-path gates above.

[on]
--loose-innodb-index-shrink=ON
--loose-innodb-index-lock-upgrade-root=ON
--loose-innodb-defer-purge-merges=OFF

[shrink_off]
--loose-innodb-index-shrink=OFF
--loose-innodb-index-lock-upgrade-root=ON
--loose-innodb-defer-purge-merges=OFF

[root_off]
--loose-innodb-index-shrink=ON
--loose-innodb-index-lock-upgrade-root=OFF
--loose-innodb-defer-purge-merges=OFF

[both_off]
--loose-innodb-index-shrink=OFF
--loose-innodb-index-lock-upgrade-root=OFF
--loose-innodb-defer-purge-merges=OFF

[defer]
--loose-innodb-index-shrink=ON
--loose-innodb-index-lock-upgrade-root=ON
--loose-innodb-defer-purge-merges=ON

[shrink_off_defer]
--loose-innodb-index-shrink=OFF
--loose-innodb-index-lock-upgrade-root=ON
--loose-innodb-defer-purge-merges=ON

[root_off_defer]
--loose-innodb-index-shrink=ON
--loose-innodb-index-lock-upgrade-root=OFF
--loose-innodb-defer-purge-merges=ON

[both_off_defer]
--loose-innodb-index-shrink=OFF
--loose-innodb-index-lock-upgrade-root=OFF
--loose-innodb-defer-purge-merges=ON
