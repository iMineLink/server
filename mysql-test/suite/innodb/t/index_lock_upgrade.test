--source include/have_innodb.inc
--source include/have_innodb_16k.inc

--echo #
--echo # MDEV-38814: btr_cur_need_opposite_intention() should not
--echo # trigger index lock upgrade on the root page
--echo #

--echo # Test with simple table structure:
--echo # Single INT primary key
--echo # DATETIME column dt that starts NULL and gets updated to NOW()
--echo #
--echo # The NULL-to-DATETIME growth (0 → 5 bytes) makes
--echo # btr_cur_optimistic_update() return DB_OVERFLOW on a full page,
--echo # falling through to the pessimistic path (BTR_MODIFY_TREE).
--echo #
--echo # 5000 rows (~15 bytes each) produce enough page splits to exercise
--echo # the btr_insert_into_right_sibling() guard and index lock upgrade logic.
CREATE TABLE t1 (
  id INT NOT NULL,
  dt DATETIME NULL,
  PRIMARY KEY (id)
) ENGINE=InnoDB;

--let $n_rows= 5000

# Snapshot all counters before the INSERT phase
--disable_query_log
SELECT
  MAX(IF(VARIABLE_NAME='INNODB_BTR_INDEX_LOCK_UPGRADES', VARIABLE_VALUE, NULL)),
  MAX(IF(VARIABLE_NAME='INNODB_BTR_NEED_OPPOSITE_INTENTION_ROOT', VARIABLE_VALUE, NULL)),
  MAX(IF(VARIABLE_NAME='INNODB_BTR_INSERT_RIGHT_SIBLING_X', VARIABLE_VALUE, NULL)),
  MAX(IF(VARIABLE_NAME='INNODB_BTR_INSERT_RIGHT_SIBLING_SX_SKIP', VARIABLE_VALUE, NULL))
INTO @b_upgrades, @b_root, @b_rs_x, @b_rs_sx
FROM INFORMATION_SCHEMA.GLOBAL_STATUS
WHERE VARIABLE_NAME LIKE 'INNODB_BTR_%';

--let $count= 0
while ($count < $n_rows)
{
  --eval INSERT INTO t1 (id, dt) VALUES ($count + 1, NULL)
  inc $count;
}
--enable_query_log

--echo # Rows inserted with NULL DATETIME
SELECT COUNT(*) AS rows_inserted FROM t1;

# Compute INSERT phase deltas
--disable_query_log
SELECT
  MAX(IF(VARIABLE_NAME='INNODB_BTR_INDEX_LOCK_UPGRADES', VARIABLE_VALUE, NULL)) - @b_upgrades,
  MAX(IF(VARIABLE_NAME='INNODB_BTR_NEED_OPPOSITE_INTENTION_ROOT', VARIABLE_VALUE, NULL)) - @b_root,
  MAX(IF(VARIABLE_NAME='INNODB_BTR_INSERT_RIGHT_SIBLING_X', VARIABLE_VALUE, NULL)) - @b_rs_x,
  MAX(IF(VARIABLE_NAME='INNODB_BTR_INSERT_RIGHT_SIBLING_SX_SKIP', VARIABLE_VALUE, NULL)) - @b_rs_sx
INTO @i_upgrades, @i_root, @i_rs_x, @i_rs_sx
FROM INFORMATION_SCHEMA.GLOBAL_STATUS
WHERE VARIABLE_NAME LIKE 'INNODB_BTR_%';
--enable_query_log

--echo # Counters after INSERT phase (delta)
SELECT @i_upgrades AS index_lock_upgrades,
       @i_root AS opposite_intention_root,
       @i_rs_x AS right_sibling_x,
       @i_rs_sx AS right_sibling_sx_skip;

--echo # Now update all rows: NULL → NOW() triggers pessimistic path
--echo # due to record size growth on full pages.

# Snapshot before UPDATE phase
--disable_query_log
SELECT
  MAX(IF(VARIABLE_NAME='INNODB_BTR_INDEX_LOCK_UPGRADES', VARIABLE_VALUE, NULL)),
  MAX(IF(VARIABLE_NAME='INNODB_BTR_NEED_OPPOSITE_INTENTION_ROOT', VARIABLE_VALUE, NULL)),
  MAX(IF(VARIABLE_NAME='INNODB_BTR_INSERT_RIGHT_SIBLING_X', VARIABLE_VALUE, NULL)),
  MAX(IF(VARIABLE_NAME='INNODB_BTR_INSERT_RIGHT_SIBLING_SX_SKIP', VARIABLE_VALUE, NULL))
INTO @b2_upgrades, @b2_root, @b2_rs_x, @b2_rs_sx
FROM INFORMATION_SCHEMA.GLOBAL_STATUS
WHERE VARIABLE_NAME LIKE 'INNODB_BTR_%';

--let $count= 0
while ($count < $n_rows)
{
  --eval UPDATE t1 SET dt = NOW() WHERE id = $count + 1
  inc $count;
}
--enable_query_log

--echo # Rows updated
SELECT COUNT(*) AS null_dt FROM t1 WHERE dt IS NULL;

# Compute UPDATE phase deltas
--disable_query_log
SELECT
  MAX(IF(VARIABLE_NAME='INNODB_BTR_INDEX_LOCK_UPGRADES', VARIABLE_VALUE, NULL)) - @b2_upgrades,
  MAX(IF(VARIABLE_NAME='INNODB_BTR_NEED_OPPOSITE_INTENTION_ROOT', VARIABLE_VALUE, NULL)) - @b2_root,
  MAX(IF(VARIABLE_NAME='INNODB_BTR_INSERT_RIGHT_SIBLING_X', VARIABLE_VALUE, NULL)) - @b2_rs_x,
  MAX(IF(VARIABLE_NAME='INNODB_BTR_INSERT_RIGHT_SIBLING_SX_SKIP', VARIABLE_VALUE, NULL)) - @b2_rs_sx
INTO @u_upgrades, @u_root, @u_rs_x, @u_rs_sx
FROM INFORMATION_SCHEMA.GLOBAL_STATUS
WHERE VARIABLE_NAME LIKE 'INNODB_BTR_%';
--enable_query_log

--echo # Counters after UPDATE phase (delta)
SELECT @u_upgrades AS index_lock_upgrades,
       @u_root AS opposite_intention_root,
       @u_rs_x AS right_sibling_x,
       @u_rs_sx AS right_sibling_sx_skip;

--echo # Total counters (delta from start)
SELECT @i_upgrades + @u_upgrades AS index_lock_upgrades,
       @i_root + @u_root AS opposite_intention_root,
       @i_rs_x + @u_rs_x AS right_sibling_x,
       @i_rs_sx + @u_rs_sx AS right_sibling_sx_skip;

DROP TABLE t1;
