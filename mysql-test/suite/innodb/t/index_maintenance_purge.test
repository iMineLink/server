let $ps4= `SELECT COUNT_RESET FROM INFORMATION_SCHEMA.INNODB_METRICS
               WHERE NAME = 'index_page_splits'`;
let $ma4= `SELECT COUNT_RESET FROM INFORMATION_SCHEMA.INNODB_METRICS
               WHERE NAME = 'index_page_merge_attempts'`;
let $ms4= `SELECT COUNT_RESET FROM INFORMATION_SCHEMA.INNODB_METRICS
               WHERE NAME = 'index_page_merge_successful'`;
let $rs4= `SELECT COUNT_RESET FROM INFORMATION_SCHEMA.INNODB_METRICS
               WHERE NAME = 'index_page_reorg_successful'`;
let $pd4= `SELECT COUNT_RESET FROM INFORMATION_SCHEMA.INNODB_METRICS
               WHERE NAME = 'index_page_discards'`;
let $lu4= `SELECT VARIABLE_VALUE FROM INFORMATION_SCHEMA.GLOBAL_STATUS
               WHERE VARIABLE_NAME = 'Innodb_btr_cur_n_index_lock_upgrades'`;
let $pi4= `SELECT VARIABLE_VALUE FROM INFORMATION_SCHEMA.GLOBAL_STATUS
               WHERE VARIABLE_NAME = 'Innodb_btr_cur_pessimistic_insert_calls'`;
let $pu4= `SELECT VARIABLE_VALUE FROM INFORMATION_SCHEMA.GLOBAL_STATUS
               WHERE VARIABLE_NAME = 'Innodb_btr_cur_pessimistic_update_calls'`;
let $pe4= `SELECT VARIABLE_VALUE FROM INFORMATION_SCHEMA.GLOBAL_STATUS
               WHERE VARIABLE_NAME = 'Innodb_btr_cur_pessimistic_delete_calls'`;
let $ou4= `SELECT VARIABLE_VALUE FROM INFORMATION_SCHEMA.GLOBAL_STATUS
               WHERE VARIABLE_NAME = 'Innodb_btr_cur_pessimistic_update_optim_err_underflows'`;
let $oo4= `SELECT VARIABLE_VALUE FROM INFORMATION_SCHEMA.GLOBAL_STATUS
               WHERE VARIABLE_NAME = 'Innodb_btr_cur_pessimistic_update_optim_err_overflows'`;

--disable_query_log
eval SELECT $ps4 - $ps3 AS index_page_splits_delete_random;
eval SELECT $ma4 - $ma3 AS index_page_merge_attempts_delete_random;
eval SELECT $ms4 - $ms3 AS index_page_merge_successful_delete_random;
eval SELECT $rs4 - $rs3 AS index_page_reorg_successful_delete_random;
eval SELECT $pd4 - $pd3 AS index_page_discards_delete_random;
eval SELECT $lu4 - $lu3 AS index_lock_upgrades_delete_random;
eval SELECT $pi4 - $pi3 AS pessimistic_insert_calls_delete_random;
eval SELECT $pu4 - $pu3 AS pessimistic_update_calls_delete_random;
eval SELECT $pe4 - $pe3 AS pessimistic_delete_calls_delete_random;
eval SELECT $ou4 - $ou3 AS optim_err_underflows_delete_random;
eval SELECT $oo4 - $oo3 AS optim_err_overflows_delete_random;
--enable_query_log

DROP TABLE t2;

--disable_query_log
SET GLOBAL innodb_stats_persistent= @save_stats_persistent;
SET GLOBAL innodb_monitor_disable= 'module_index';
--disable_warnings
SET GLOBAL innodb_monitor_disable= default;
SET GLOBAL innodb_monitor_enable= default;
--enable_warnings
--enable_query_log
