--disable_query_log
eval SELECT $ps1 - $ps0 AS index_page_splits_insert;
eval SELECT $ma1 - $ma0 AS index_page_merge_attempts_insert;
eval SELECT $ms1 - $ms0 AS index_page_merge_successful_insert;
eval SELECT $rs1 - $rs0 AS index_page_reorg_successful_insert;
eval SELECT $pd1 - $pd0 AS index_page_discards_insert;
eval SELECT $lu1 - $lu0 AS index_lock_upgrades_insert;
eval SELECT $pi1 - $pi0 AS pessimistic_insert_calls_insert;
eval SELECT $pu1 - $pu0 AS pessimistic_update_calls_insert;
eval SELECT $pe1 - $pe0 AS pessimistic_delete_calls_insert;
eval SELECT $ou1 - $ou0 AS optim_err_underflows_insert;
eval SELECT $oo1 - $oo0 AS optim_err_overflows_insert;
--enable_query_log

DELETE FROM t1 WHERE id > (SELECT MAX(id) FROM t1) / 2;

