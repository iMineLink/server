--source include/have_innodb.inc
--source include/have_innodb_max_16k.inc
--source include/have_debug_sync.inc

--echo #
--echo # MDEV-38056 A locking read that reconstructs old versions of a
--echo # ROW_FORMAT=COMPRESSED record for an implicit-lock check dereferences
--echo # their externally stored columns, so it must keep purge_sys.view frozen
--echo # until it is done: the visibility check that let it reconstruct a
--echo # version only proves the BLOB pages were allocated while that check ran.
--echo # Here the transaction it references commits meanwhile, which deregisters
--echo # it from trx_sys before it waits for the reader's reference and thereby
--echo # makes its history purgeable. Before the fix this hit
--echo # buf_page_t* buf_page_get_zip(page_id_t): Assertion
--echo # `bpage->state() >= buf_page_t::UNFIXED' failed.
--echo #

--source include/wait_all_purged.inc

CREATE TABLE t(a INT PRIMARY KEY, b TEXT, UNIQUE(b(700)))
ENGINE=InnoDB STATS_PERSISTENT=0 ROW_FORMAT=COMPRESSED;

INSERT INTO t VALUES (1, CONCAT('x', REPEAT('x', @@innodb_page_size)));

# Filler rows whose UNIQUE(b(700)) keys sort between the 'y...' and 'z...'
# values that row a=1 will take below, so that the delete-marked secondary
# index entries for the 'x...' and 'y...' values end up on different
# secondary index leaf pages than the live 'z...' entry. The reader parked
# below latches only the 'z...' entry's leaf page; purge must latch the
# pages of the delete-marked entries before freeing the old BLOBs, so on a
# shared page it would block and the BLOBs would never be freed.
--disable_query_log
let $i= 60;
while ($i)
{
  eval INSERT INTO t VALUES (100 + $i,
                             CONCAT('y~', LPAD($i, 3, '0'), REPEAT('-', 800)));
  dec $i;
}
--enable_query_log

SET GLOBAL innodb_max_purge_lag_wait= 0;
SET GLOBAL innodb_monitor_enable='purge_upd_exist_or_extern_records';

BEGIN;
UPDATE t SET b = CONCAT('y', REPEAT('y', @@innodb_page_size)) WHERE a = 1;
UPDATE t SET b = CONCAT('z', REPEAT('z', @@innodb_page_size)) WHERE a = 1;

# The locking read finds the secondary index entry of the 'z...' value,
# whose clustered index record carries the identifier of the still active
# transaction above, references that transaction, and parks inside
# row_vers_impl_x_locked_low() after building the previous version of the
# clustered index record but before dereferencing its BLOB pointers.
connect (reader,localhost,root,,);
SET DEBUG_SYNC='before_row_vers_impl_x_locked_row_build SIGNAL parked WAIT_FOR resume';
--send SELECT a FROM t FORCE INDEX(b) WHERE b LIKE 'z%' FOR UPDATE

# COMMIT deregisters the transaction from trx_sys, which makes its undo
# history purgeable, and then spins waiting for the reference that the
# parked implicit lock check is holding.
connection default;
SET DEBUG_SYNC='now WAIT_FOR parked';
--send COMMIT

connect (con3,localhost,root,,);
# The transaction has deregistered itself and its update undo records are
# purgeable, but the parked reader holds purge_sys.latch, so purge cannot
# refresh its view and no batch can reach those records. The externally stored
# BLOBs of the old 'x...' and 'y...' versions must therefore still be
# allocated when the reader dereferences them.
# Give purge every chance to free them, for as long as it would need without
# the fix (it takes about a second there, so this waits five). The loop must
# stay: it is what makes the assertion below fail rather than pass by accident
# when the freeze is missing.
--disable_query_log
let $wait= 50;
while ($wait)
{
  let $freed= `SELECT count FROM information_schema.innodb_metrics WHERE name = 'purge_upd_exist_or_extern_records'`;
  if ($freed)
  {
    let $wait= 0;
  }
  if (!$freed)
  {
    real_sleep 0.1;
    dec $wait;
  }
}
--enable_query_log
SELECT count AS externs_freed_while_parked FROM information_schema.innodb_metrics
WHERE name = 'purge_upd_exist_or_extern_records';
SET DEBUG_SYNC='now SIGNAL resume';

# The parked reader now reconstructs the intermediate 'y...' version and
# dereferences its BLOB, which is still there, so the implicit-lock check
# completes and the read returns normally.
connection reader;
--reap

connection default;
--reap
disconnect reader;

# Once the reader is done, purge is free to advance and to free both BLOBs,
# which confirms they were freeable all along and that only the frozen view
# held purge back.
connection con3;
let $wait_condition=
  SELECT count >= 2 FROM information_schema.innodb_metrics
  WHERE name = 'purge_upd_exist_or_extern_records';
--source include/wait_condition.inc

connection default;
disconnect con3;
SET DEBUG_SYNC='RESET';
DROP TABLE t;
# Turn the monitor off, then zero its (server-lifetime cumulative) counter so a
# later test on the same server sees a clean count, and restore the monitor
# system variables to their defaults.
SET GLOBAL innodb_monitor_disable='purge_upd_exist_or_extern_records';
SET GLOBAL innodb_monitor_reset_all='purge_upd_exist_or_extern_records';
SET GLOBAL innodb_monitor_enable=default;
SET GLOBAL innodb_monitor_disable=default;
SET GLOBAL innodb_monitor_reset_all=default;
SET GLOBAL innodb_max_purge_lag_wait=default;
