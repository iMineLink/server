--source include/have_innodb.inc
--source include/have_innodb_max_16k.inc
--source include/have_debug_sync.inc

--echo #
--echo # MDEV-38056 A version reached by walking the clustered index version
--echo # chain inherits the field of every column that its own undo log record
--echo # does not update. For an externally stored column that means it carries
--echo # the reference that a *newer* undo log record disowned, so purging that
--echo # newer record frees the BLOB. Freezing purge_sys.view covers this too:
--echo # reaching such a version requires every transaction whose undo log
--echo # record was applied on the way down to be invisible to that view, and
--echo # the record that disowned the reference is one of them. The freeze must
--echo # therefore span the whole walk, not one reconstruction. Otherwise this
--echo # hits buf_page_t* buf_page_get_zip(page_id_t): Assertion
--echo # `bpage->state() >= buf_page_t::UNFIXED' failed.
--echo #

--source include/wait_all_purged.inc

CREATE TABLE t(a INT PRIMARY KEY, pad INT, b TEXT, UNIQUE(b(700)))
ENGINE=InnoDB STATS_PERSISTENT=0 ROW_FORMAT=COMPRESSED;

INSERT INTO t VALUES (1, 0, CONCAT('x', REPEAT('x', @@innodb_page_size)));

# Filler rows whose UNIQUE(b(700)) keys sort between the 'x...' value that row
# a=1 starts with and the 'z...' value it takes below, so that the
# delete-marked 'x...' secondary entry (which purge removes) and the live
# 'z...' entry (which the rollback latches) end up on different secondary
# index leaf pages. On a shared page purge would block on the rollback's leaf
# latch and the old BLOB would never be freed.
--disable_query_log
let $i= 60;
while ($i)
{
  eval INSERT INTO t VALUES (100 + $i, 0,
                             CONCAT('y~', LPAD($i, 3, '0'), REPEAT('-', 800)));
  dec $i;
}
--enable_query_log

SET GLOBAL innodb_monitor_enable='purge_upd_exist_or_extern_records';

# Pin a read view on the 'x...' committed state, so that the two updates below
# stay reachable by the version chain walk and their BLOBs stay allocated until
# we release it.
connect (purge_control,localhost,root,,);
START TRANSACTION WITH CONSISTENT SNAPSHOT;

connection default;
# Committed update whose undo log record does NOT mention b. The version it
# produces will inherit whatever reference b holds in the next newer version.
UPDATE t SET pad = 1 WHERE a = 1;

# Committed update that does mention b: it disowns the 'x...' BLOB, which its
# own undo log record owns and purge will free.
UPDATE t SET b = CONCAT('y', REPEAT('y', @@innodb_page_size)) WHERE a = 1;

# The transaction that will roll back: its UPDATE delete-marks the 'y...'
# secondary entry and inserts the live 'z...' entry.
connect (victim,localhost,root,,);
BEGIN;
UPDATE t SET b = CONCAT('z', REPEAT('z', @@innodb_page_size)) WHERE a = 1;

# On ROLLBACK, row_undo_mod_sec_is_unsafe() walks 'z...' -> 'y...' -> 'x...' ->
# 'x...' (the last one being the version the pad update produced) and rebuilds
# each of them. Park before all three row_build() calls.
SET DEBUG_SYNC='before_row_undo_mod_sec_is_unsafe_row_build SIGNAL parked WAIT_FOR resume EXECUTE 3';
--send ROLLBACK

connection default;
# Hit 1: the 'y...' version, from the victim's own undo log record. That BLOB
# belongs to the rolling back transaction and can never be freed by purge.
SET DEBUG_SYNC='now WAIT_FOR parked TIMEOUT 60';
SET DEBUG_SYNC='now SIGNAL resume';

# Hit 2: the 'x...' version, from the undo log record of the b update. That
# record carries the prefix of the 'x...' value.
SET DEBUG_SYNC='now WAIT_FOR parked TIMEOUT 60';
SET DEBUG_SYNC='now SIGNAL resume';

# Hit 3: the version the pad update produced. Its undo log record says nothing
# about b, so this version merely inherits the 'x...' reference, which is the
# freeable one. Release the read view, the last thing that kept that BLOB from
# being freeable, while the rollback is parked.
SET DEBUG_SYNC='now WAIT_FOR parked TIMEOUT 60';

connection purge_control;
COMMIT;
disconnect purge_control;

connection default;
# The rollback holds purge_sys.latch, so purge cannot refresh its view to one
# that sees the two committed updates, and the inherited BLOB must still be
# allocated when the rollback dereferences it. Give purge every chance to free
# it, for as long as it would need without the fix (it takes about a second
# there, so this waits five). The loop must stay: it is what makes the
# assertion below fail rather than pass by accident when the freeze is missing.
--disable_query_log
let $wait= 50;
while ($wait)
{
  let $freed= `SELECT count FROM information_schema.innodb_metrics WHERE name = 'purge_upd_exist_or_extern_records'`;
  if ($freed)
  {
    let $wait= 0;
  }
  if (!$freed)
  {
    real_sleep 0.1;
    dec $wait;
  }
}
--enable_query_log
SELECT count AS externs_freed_while_parked FROM information_schema.innodb_metrics
WHERE name = 'purge_upd_exist_or_extern_records';

SET DEBUG_SYNC='now SIGNAL resume';

connection victim;
--reap

connection default;
disconnect victim;

# Once the rollback is done, purge is free to advance and to free the BLOBs of
# both committed updates, which confirms they were freeable all along and that
# only the frozen view held purge back.
let $wait_condition=
  SELECT count >= 2 FROM information_schema.innodb_metrics
  WHERE name = 'purge_upd_exist_or_extern_records';
--source include/wait_condition.inc

SET DEBUG_SYNC='RESET';

# The rollback reverted to the committed 'y...' value, and the secondary index
# agrees with the clustered index.
SELECT a, pad FROM t FORCE INDEX(b) WHERE b LIKE 'yy%';
CHECK TABLE t;
DROP TABLE t;
# Turn the monitor off, then zero its (server-lifetime cumulative) counter so a
# later test on the same server sees a clean count, and restore the monitor
# system variables to their defaults.
SET GLOBAL innodb_monitor_disable='purge_upd_exist_or_extern_records';
SET GLOBAL innodb_monitor_reset_all='purge_upd_exist_or_extern_records';
SET GLOBAL innodb_monitor_enable=default;
SET GLOBAL innodb_monitor_disable=default;
SET GLOBAL innodb_monitor_reset_all=default;
