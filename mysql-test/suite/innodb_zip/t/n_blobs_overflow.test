#
# MDEV-33966: page_zip_des_t::state packs ssize, the
# PROMOTED/NONEMPTY/ACCESSED/OLD flags, and the n_blobs count into one
# atomic word. The count of externally stored columns on a single 16 KiB
# ROW_FORMAT=COMPRESSED leaf can reach 744, which does not fit in a
# 16-bit word once the flags are accounted for; the word is 32 bits wide.
#
# This test builds a leaf carrying more than 511 external BLOB pointers
# (which a 16-bit layout could not represent) and verifies it inserts and
# reads back intact.
#

--source include/have_innodb.inc
--source include/have_innodb_16k.inc
--source include/not_embedded.inc

SET @save_strict = @@global.innodb_strict_mode;
SET @save_ro_zip = @@global.innodb_read_only_compressed;
SET @@global.innodb_strict_mode         = OFF;
SET @@global.innodb_read_only_compressed = OFF;

# Build a wide BLOB-only schema. Each LONGBLOB column contributes one
# off-page pointer per row whenever its value exceeds the 767-byte
# inline threshold. Each external reference is 20 bytes in the record
# body, so a single row is bounded to ~400 columns by the half-page
# row-size rule. Two rows packed on one 16 KiB compressed leaf
# multiply the count past 511.

--disable_query_log
let $cols = 350;
let $rows = 2;
let $col_defs = ;
let $i = 1;
while ($i <= $cols) {
  let $col_defs = $col_defs , `b$i` LONGBLOB;
  inc $i;
}
eval CREATE TABLE big_blobs (id INT PRIMARY KEY $col_defs)
  ENGINE=InnoDB ROW_FORMAT=COMPRESSED KEY_BLOCK_SIZE=16;
--enable_query_log

# Insert $rows rows; each row's $cols LONGBLOBs all spill off-page.
# Expected aggregate on the holding leaf: $cols * $rows = 700 pointers,
# beyond what a 16-bit state word could represent.

--disable_query_log
let $vals = ;
let $j = 1;
while ($j <= $cols) {
  let $vals = $vals, REPEAT('x', 800);
  inc $j;
}
let $r = 1;
while ($r <= $rows) {
  eval INSERT INTO big_blobs VALUES ($r $vals);
  inc $r;
}
--enable_query_log

SELECT COUNT(*) FROM big_blobs;
CHECK TABLE big_blobs;

DROP TABLE big_blobs;

SET @@global.innodb_strict_mode          = @save_strict;
SET @@global.innodb_read_only_compressed = @save_ro_zip;
